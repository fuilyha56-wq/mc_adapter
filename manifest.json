{
    "name": "mc_adapter",
    "display_name": "Minecraft 适配器",
    "version": "1.0.0",
    "description": "基于 mineflayer bridge 的 Minecraft 平台适配器，支持加入游戏与聊天收发，并通过 MCBridgeService 暴露 RPC 通道供工具插件（如 mc_tools）调用",
    "author": "MoFox Team",
    "categories": ["tool"],
    "tags": ["minecraft", "adapter", "bridge"],
    "dependencies": {
        "plugins": [],
        "components": []
    },
    "include": [
        {
            "component_type": "adapter",
            "component_name": "mc_adapter",
            "description": "Minecraft 平台适配器，桥接 mineflayer bridge",
            "dependencies": []
        },
        {
            "component_type": "service",
            "component_name": "mc_bridge",
            "description": "MC bridge RPC 服务，暴露 send_chat/get_status/ping/call_rpc/follow_player 等方法供其他组件调用",
            "dependencies": []
        }
    ],
    "entry_point": "plugin.py",
    "min_core_version": "1.0.0",
    "python_dependencies": [
        "orjson>=3.8.0"
    ],
    "dependencies_required": true
}

